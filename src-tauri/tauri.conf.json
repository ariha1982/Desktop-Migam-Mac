{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Migam Mac",
  "version": "0.1.0",
  "identifier": "com.migam.desktop.mac",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Desktop Pet",
        "width": 128,
        "height": 128,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "card",
        "title": "Desktop Pet Kick",
        "width": 220,
        "height": 180,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "timer",
        "title": "Desktop Pet Timer",
        "width": 156,
        "height": 76,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "todo",
        "title": "감자봇 할 일",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "Desktop Pet Settings",
        "width": 720,
        "height": 620,
        "visible": false,
        "resizable": true
      },
      {
        "label": "gamcha-notice",
        "title": "GAMCHA Reward",
        "width": 196,
        "height": 82,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "gamcha",
        "title": "GAMCHA!",
        "width": 380,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "pet-menu",
        "title": "Desktop Pet Command",
        "width": 292,
        "height": 490,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": false
      },
      {
        "label": "photo-delivery",
        "title": "Gamza Photo Delivery",
        "width": 640,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../images/app/icon.icns"]
  }
}
